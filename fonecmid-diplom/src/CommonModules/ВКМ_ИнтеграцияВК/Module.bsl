#Область ПрограммныйИнтерфейс

// Отправляет текстовое сообщение в беседу ВКонтакте по настройкам из констант.
//
// Параметры:
//  ТекстСообщения - Строка - текст отправляемого уведомления.
//
// Возвращаемое значение:
//  Булево - Истина, если сообщение успешно принято сервером ВКонтакте.
//
Функция ОтправитьСообщение(ТекстСообщения) Экспорт
	
	Токен = Константы.ВКМ_ТокенСообществаВК.Получить();
	ИдентификаторЧата = Константы.ВКМ_ИдентификаторЧатаВК.Получить();
	
	Если ПустаяСтрока(Токен) Или ПустаяСтрока(ИдентификаторЧата) Или ПустаяСтрока(ТекстСообщения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Генератор = Новый ГенераторСлучайныхЧисел();
		RandomID = Формат(Генератор.СлучайноеЧисло(1, 2147483647), "ЧГ=0");
		
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("peer_id", СокрЛП(ИдентификаторЧата));
		ПараметрыЗапроса.Вставить("random_id", RandomID);
		ПараметрыЗапроса.Вставить("message", ТекстСообщения);
		ПараметрыЗапроса.Вставить("access_token", СокрЛП(Токен));
		ПараметрыЗапроса.Вставить("v", "5.199");
		
		ТелоЗапроса = ПараметрыВСтрокуЗапроса(ПараметрыЗапроса);
		
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
		Соединение = Новый HTTPСоединение("api.vk.com", 443, , , , 10, ЗащищенноеСоединение);
		
		HTTPЗапрос = Новый HTTPЗапрос("/method/messages.send");
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=utf-8");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		
		Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON, Истина);
			ЧтениеJSON.Закрыть();
			
			Если ДанныеОтвета.Получить("error") = Неопределено Тогда
				Возврат Истина;
			Иначе
				ЗаписьЖурналаРегистрации(
					"ВКМ_ИнтеграцияВК.ОтправитьСообщение",
					УровеньЖурналаРегистрации.Ошибка,
					,
					,
					"Ошибка API ВКонтакте: " + ТелоОтвета
				);
			КонецЕсли;
		Иначе
			ЗаписьЖурналаРегистрации(
				"ВКМ_ИнтеграцияВК.ОтправитьСообщение",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				СтрШаблон("Ошибка HTTP при обращении к API ВКонтакте. Код: %1", Ответ.КодСостояния)
			);
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации(
			"ВКМ_ИнтеграцияВК.ОтправитьСообщение",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки()
		);
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

// Обработчик регламентного задания:
// обходит справочник очереди уведомлений, отправляет и удаляет отправленные элементы.
//
Процедура ОтправитьНакопленныеУведомления() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Уведомления.Ссылка КАК Ссылка,
	|	Уведомления.ТекстСообщения КАК ТекстСообщения
	|ИЗ
	|	Справочник.ВКМ_УведомленияВКДляОтправки КАК Уведомления
	|ГДЕ
	|	НЕ Уведомления.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ОтправитьСообщение(Выборка.ТекстСообщения) Тогда
			ОбъектУведомления = Выборка.Ссылка.ПолучитьОбъект();
			ОбъектУведомления.Удалить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыВСтрокуЗапроса(Параметры)
	
	ЧастиСтроки = Новый Массив;
	Для Каждого КлючИЗначение Из Параметры Цикл
		ИмяПараметра = КодироватьСтроку(КлючИЗначение.Ключ, СпособКодированияСтроки.КодировкаURL);
		ЗначениеПараметра = КодироватьСтроку(Строка(КлючИЗначение.Значение), СпособКодированияСтроки.КодировкаURL);
		ЧастиСтроки.Добавить(ИмяПараметра + "=" + ЗначениеПараметра);
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиСтроки, "&");
	
КонецФункции

#КонецОбласти
