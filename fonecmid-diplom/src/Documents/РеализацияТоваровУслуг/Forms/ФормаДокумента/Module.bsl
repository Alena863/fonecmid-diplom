
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	
	//++ ВКМ Добавление команды Заполнить для автозаполнения документа с типом абонентская плата
    НоваяКоманда = Команды.Добавить("ВКМ_Заполнить");
    НоваяКоманда.Заголовок = "Заполнить";
    НоваяКоманда.Действие = "ВКМ_Заполнить";
    НоваяКнопка = Элементы.Добавить("ВКМ_Заполнить", Тип("КнопкаФормы"),Элементы.ФормаКоманднаяПанель);
    НоваяКнопка.ИмяКоманды = "ВКМ_Заполнить";
   //--ВКМ
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
    ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
КонецПроцедуры

#КонецОбласти

//++ВКМ Функции кнопки заполнить для автозаполнения документов
// ++ ВКМ_АвтозаполнениеАбонентскогоОбслуживания
&НаКлиенте
Асинх Процедура ВКМ_Заполнить(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выберите договор в шапке документа.'"));
		Возврат;
	КонецЕсли;
	
	// Сначала проверяем на сервере, что договор действительно абонентский
	Если НЕ ВКМ_ЭтоДоговорАбонентскогоОбслуживания(Объект.Договор) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Автозаполнение доступно только для договоров с видом «Абонентское обслуживание».'"));
		Возврат;
	КонецЕсли;
	
	// И только теперь, если таблица не пустая, спрашиваем подтверждение очистки
	Если Объект.Товары.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх(
			НСтр("ru = 'Табличная часть будет очищена и заполнена заново. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет
		);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ВКМ_ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВКМ_ЭтоДоговорАбонентскогоОбслуживания(Договор)
	
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговора");
	Возврат (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание);
	
КонецФункции

&НаСервере
Процедура ВКМ_ЗаполнитьНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	Попытка
		ДокументОбъект.ВКМ_ВыполнитьАвтозаполнение();
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры
// -- ВКМ_АвтозаполнениеАбонентскогоОбслуживания


//--ВКМ

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	РассчитатьСуммуСтроки(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	РассчитатьСуммуСтроки(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

#КонецОбласти

