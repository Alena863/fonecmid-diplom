#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Проверка уникальности работ в табличной части
	НайденныеСтроки = Новый Соответствие;
	Для Каждого СтрокаРабот Из ВыполненныеРаботы Цикл
		КлючРаботы = НРег(СокрЛП(СтрокаРабот.ОписаниеРабот));
		Если ПустаяСтрока(КлючРаботы) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НайденныеСтроки[КлючРаботы] <> Неопределено Тогда
			ТекстСообщения = СтрШаблон(
				"Работа «%1» указана в таблице несколько раз (строки %2 и %3).",
				СтрокаРабот.ОписаниеРабот,
				НайденныеСтроки[КлючРаботы],
				СтрокаРабот.НомерСтроки
			);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ЭтотОбъект,
				СтрШаблон("ВыполненныеРаботы[%1].ОписаниеРабот", СтрокаРабот.НомерСтроки - 1),
				,
				Отказ
			);
		Иначе
			НайденныеСтроки.Вставить(КлючРаботы, СтрокаРабот.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТекстУведомления = СформироватьТекстУведомленияОбИзменениях();
	
	Если НЕ ПустаяСтрока(ТекстУведомления) Тогда
		НовоеУведомление = Справочники.ВКМ_УведомленияВКДляОтправки.СоздатьЭлемент();
		НовоеУведомление.ТекстСообщения = ТекстУведомления;
		НовоеУведомление.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 1. Получение данных договора через программный интерфейс БСП
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнен договор.", ЭтотОбъект, "Договор", , Отказ);
		Возврат;
	КонецЕсли;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Договор,
		"ВидДоговора, ВКМ_ДатаНачала, ВКМ_ДатаОкончания, ВКМ_СтоимостьЧасаРаботы"
	);
	
	// Проверка типа договора (Абонентское обслуживание)
	Если РеквизитыДоговора.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда
		ОбщегоНазначения.СообщитьПользователю(
			"Проведение невозможно: выбранный договор не относится к типу «Абонентское обслуживание».",
			ЭтотОбъект,
			"Договор",
			,
			Отказ
		);
		Возврат;
	КонецЕсли;
	
	// Проверка попадания даты документа в период действия договора
	Если НЕ ЗначениеЗаполнено(РеквизитыДоговора.ВКМ_ДатаНачала)
		Или НЕ ЗначениеЗаполнено(РеквизитыДоговора.ВКМ_ДатаОкончания) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			"В выбранном договоре не заполнены дата начала или дата окончания действия.",
			ЭтотОбъект,
			"Договор",
			,
			Отказ
		);
		Возврат;
	КонецЕсли;
	
	ДатаДокументаБезВремени = НачалоДня(Дата);
	Если ДатаДокументаБезВремени < НачалоДня(РеквизитыДоговора.ВКМ_ДатаНачала)
		Или ДатаДокументаБезВремени > НачалоДня(РеквизитыДоговора.ВКМ_ДатаОкончания) Тогда
		
		ТекстСообщения = СтрШаблон(
			"Дата документа (%1) не входит в период действия договора (с %2 по %3).",
			Формат(Дата, "ДЛФ=Д"),
			Формат(РеквизитыДоговора.ВКМ_ДатаНачала, "ДЛФ=Д"),
			Формат(РеквизитыДоговора.ВКМ_ДатаОкончания, "ДЛФ=Д")
		);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "Дата", , Отказ);
		Возврат;
	КонецЕсли;
	
	// 2. Формирование движений по регистру накопления ВКМ_ВыполненныеКлиентуРаботы
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	
	ВсегоЧасов = ВыполненныеРаботы.Итог("ЧасыКОплатеКлиенту");
	Если ВсегоЧасов > 0 Тогда
		Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Клиент = Клиент;
		Движение.Договор = Договор;
		Движение.Количество = ВсегоЧасов;
		Движение.Сумма = Окр(ВсегоЧасов * РеквизитыДоговора.ВКМ_СтоимостьЧасаРаботы, 2);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьТекстУведомленияОбИзменениях()
	
	Если ЭтоНовый() Тогда
		Возврат СтрШаблон(
			"Создана новая заявка на обслуживание клиента %1." + Символы.ПС
			+ "Клиент: %2" + Символы.ПС
			+ "Специалист: %3" + Символы.ПС
			+ "Дата работ: %4, время: с %5 по %6" + Символы.ПС
			+ "Проблема: %7",
			Номер,
			Клиент,
			Специалист,
			Формат(ДатаПроведенияРабот, "ДЛФ=Д"),
			Формат(ВремяНачалаРабот, "ДЛФ=В"),
			Формат(ВремяОкончанияРабот, "ДЛФ=В"),
			ОписаниеПроблемы
		);
	КонецЕсли;
	
	// Получаем прежние значения реквизитов из базы данных через БСП
	СтарыеДанные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Ссылка,
		"ДатаПроведенияРабот, ВремяНачалаРабот, ВремяОкончанияРабот, Специалист"
	);
	
	МассивИзменений = Новый Массив;
	
	Если НачалоДня(СтарыеДанные.ДатаПроведенияРабот) <> НачалоДня(ДатаПроведенияРабот) Тогда
		МассивИзменений.Добавить(СтрШаблон(
			"Дата работ: %1 -> %2",
			Формат(СтарыеДанные.ДатаПроведенияРабот, "ДЛФ=Д"),
			Формат(ДатаПроведенияРабот, "ДЛФ=Д")
		));
	КонецЕсли;
	
	Если СтарыеДанные.ВремяНачалаРабот <> ВремяНачалаРабот
		Или СтарыеДанные.ВремяОкончанияРабот <> ВремяОкончанияРабот Тогда
		МассивИзменений.Добавить(СтрШаблон(
			"Время работ: с %1 по %2 -> с %3 по %4",
			Формат(СтарыеДанные.ВремяНачалаРабот, "ДЛФ=В"),
			Формат(СтарыеДанные.ВремяОкончанияРабот, "ДЛФ=В"),
			Формат(ВремяНачалаРабот, "ДЛФ=В"),
			Формат(ВремяОкончанияРабот, "ДЛФ=В")
		));
	КонецЕсли;
	
	Если СтарыеДанные.Специалист <> Специалист Тогда
		МассивИзменений.Добавить(СтрШаблон(
			"Специалист: %1 -> %2",
			СтарыеДанные.Специалист,
			Специалист
		));
	КонецЕсли;
	
	Если МассивИзменений.Количество() > 0 Тогда
		Возврат СтрШаблон(
			"Изменена заявка %1 от %2 (Клиент: %3):" + Символы.ПС + "%4",
			Номер,
			Формат(Дата, "ДЛФ=Д"),
			Клиент,
			СтрСоединить(МассивИзменений, Символы.ПС)
		);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
