#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьРеквизиты();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидДоговораПриИзменении(Элемент)
	ОбновитьРеквизиты();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьРеквизиты()
	
	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда
		Если Элементы.Найти("ГруппаВКМ_Реквизиты") = Неопределено Тогда
			СоздатьВКМГруппуИПоля();
		КонецЕсли;
		Элементы.ГруппаВКМ_Реквизиты.Видимость = Истина;
	Иначе
		Если Элементы.Найти("ГруппаВКМ_Реквизиты") <> Неопределено Тогда
			Элементы.ГруппаВКМ_Реквизиты.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьВКМГруппуИПоля()
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ВКМ_ДатаНачала", Новый ОписаниеТипов("Дата")));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ВКМ_ДатаОкончания", Новый ОписаниеТипов("Дата")));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ВКМ_АбонентскаяПлата", Новый ОписаниеТипов("Число",,,, Новый КвалификаторыЧисла(15, 2))));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ВКМ_СтоимостьЧасаРаботы", Новый ОписаниеТипов("Число",,,, Новый КвалификаторыЧисла(15, 2))));
	ИзменитьРеквизиты(МассивРеквизитов);
	
	Группа = Элементы.Добавить("ГруппаВКМ_Реквизиты", Тип("ГруппаФормы"), ЭтотОбъект);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = Ложь;
	Группа.Заголовок = "";
	Группа.РастягиватьПоГоризонтали = Истина;
	Группа.Видимость = Ложь;
	
	СоздатьВКМПоле("ПолеВКМ_ДатаНачала", "ВКМ_ДатаНачала", "Дата начала", Группа);
	СоздатьВКМПоле("ПолеВКМ_ДатаОкончания", "ВКМ_ДатаОкончания", "Дата окончания", Группа);
	СоздатьВКМПоле("ПолеВКМ_АбонентскаяПлата", "ВКМ_АбонентскаяПлата", "Ежемесячная плата (руб.)", Группа);
	СоздатьВКМПоле("ПолеВКМ_СтоимостьЧасаРаботы", "ВКМ_СтоимостьЧасаРаботы", "Стоимость часа работы (руб.)", Группа);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьВКМПоле(ИмяЭлемента, ИмяРеквизита, Заголовок, Родитель)
	
	Элемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
	Элемент.ПутьКДанным = "Объект." + ИмяРеквизита;
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.Заголовок = Заголовок;
	Элемент.Видимость = Истина;
	Элемент.РастягиватьПоГоризонтали = Истина;
	
КонецПроцедуры

#КонецОбласти
